  "intendedCues": [
    {
      "id": "cue-1",
      "scene": 1,
      "start": 0.0,
      "end": 3.6,
      "text": "Leo arrived twenty minutes early for his interview.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-2",
      "scene": 1,
      "start": 3.7333333333333334,
      "end": 6.266666666666667,
      "text": "The man beside him wore muddy boots",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-3",
      "scene": 1,
      "start": 6.366666666666666,
      "end": 8.633333333333333,
      "text": "and carried a dented toolbox.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-4",
      "scene": 2,
      "start": 8.933333333333334,
      "end": 11.7,
      "text": "Leo moved his bag off the next chair.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-5",
      "scene": 2,
      "start": 11.833333333333334,
      "end": 14.033333333333333,
      "text": "They talked while they waited.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-6",
      "scene": 3,
      "start": 14.333333333333334,
      "end": 18.466666666666665,
      "text": "When the receptionist called Leo's name, the man stood too.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-7",
      "scene": 3,
      "start": 18.6,
      "end": 21.733333333333334,
      "text": "Leo realised the stranger was the founder.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-8",
      "scene": 4,
      "start": 22.033333333333335,
      "end": 23.733333333333334,
      "text": "Leo swallowed.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-9",
      "scene": 4,
      "start": 23.833333333333332,
      "end": 27.133333333333333,
      "text": "He had spent ten minutes explaining everything wrong",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-10",
      "scene": 4,
      "start": 27.233333333333334,
      "end": 29.366666666666667,
      "text": "with the company's website.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-11",
      "scene": 5,
      "start": 29.666666666666668,
      "end": 32.166666666666664,
      "text": "The founder opened his notebook.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-12",
      "scene": 5,
      "start": 32.266666666666666,
      "end": 34.86666666666667,
      "text": "He had written down every complaint.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-13",
      "scene": 5,
      "start": 34.96666666666667,
      "end": 37.833333333333336,
      "text": "Then he asked Leo how soon he could start.",
      "evidenceType": "intended_script_not_asr"
    }
  ],
