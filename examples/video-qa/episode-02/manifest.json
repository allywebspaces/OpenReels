  "intendedCues": [
    {
      "id": "cue-1",
      "scene": 1,
      "start": 0.0,
      "end": 4.1,
      "text": "Nina stopped opening the notes her father tucked into her lunch.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-2",
      "scene": 2,
      "start": 4.4,
      "end": 6.133333333333334,
      "text": "She was seventeen.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-3",
      "scene": 2,
      "start": 6.266666666666667,
      "end": 8.9,
      "text": "His little drawings felt embarrassing.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-4",
      "scene": 2,
      "start": 9.033333333333333,
      "end": 13.133333333333333,
      "text": "Each afternoon, she dropped the folded paper into a drawer.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-5",
      "scene": 3,
      "start": 13.433333333333334,
      "end": 16.333333333333332,
      "text": "On her first day at work, years later,",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-6",
      "scene": 3,
      "start": 16.466666666666665,
      "end": 18.3,
      "text": "she reached for a note.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-7",
      "scene": 3,
      "start": 18.4,
      "end": 19.833333333333332,
      "text": "There was none.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-8",
      "scene": 3,
      "start": 19.966666666666665,
      "end": 22.266666666666666,
      "text": "Her father had died that winter.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-9",
      "scene": 4,
      "start": 22.566666666666666,
      "end": 25.166666666666668,
      "text": "That evening, she opened the drawer.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-10",
      "scene": 4,
      "start": 25.3,
      "end": 27.666666666666668,
      "text": "Beneath the jokes was one line,",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-11",
      "scene": 4,
      "start": 27.8,
      "end": 29.666666666666668,
      "text": "written again and again:",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-12",
      "scene": 4,
      "start": 29.8,
      "end": 31.533333333333335,
      "text": "I am proud of you.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-13",
      "scene": 5,
      "start": 31.833333333333332,
      "end": 35.4,
      "text": "The next morning, Nina packed her little brother's lunch.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-14",
      "scene": 5,
      "start": 35.53333333333333,
      "end": 37.56666666666667,
      "text": "She could not draw like Dad.",
      "evidenceType": "intended_script_not_asr"
    },
    {
      "id": "cue-15",
      "scene": 5,
      "start": 37.7,
      "end": 39.766666666666666,
      "text": "She folded a note anyway.",
      "evidenceType": "intended_script_not_asr"
    }
  ],
